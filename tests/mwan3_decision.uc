import {decide} from '../packages/campuslink-mwan3/files/usr/share/campuslink-mwan3/decision.uc';
let count=0;
function check(value,message) {count++;if(!value)die(message+'\n');};
let r={up:true,device:'vwan4',ip:'172.21.106.131'};
let online={state:'online',reason_code:'already_online',device:r.device,ip:r.ip,last_check:100,task_id:''};
let p=decide(null,online,r,null,1);
check(p.eligible,'confirmed online joins');
p=decide(p,{...online,state:'checking',task_id:'task-2'},r,null,1);
check(p.eligible,'periodic in-flight check retains');
p=decide(p,{...online,state:'backoff',reason_code:'dns_failed',last_check:110},r,null,1);
check(p.eligible,'DNS failure retains known online');
p=decide(p,{...online,state:'backoff',reason_code:'authenticated_no_connectivity',last_check:120},r,null,1);
check(p.eligible,'portal says logged in but unknown connectivity retains');
p=decide(p,null,r,null,1);
check(p.eligible,'missing service retains known binding');
p=decide(p,{...online,state:'disabled'},r,null,2);
check(p.eligible,'stopping auth scheduling does not log out');
p=decide(p,{...online,state:'authenticating',task_id:'task-3'},r,null,2);
check(!p.eligible,'known portal triggers authentication and removes');
p=decide(p,{...online,state:'verifying',task_id:'task-3'},r,null,2);
check(!p.eligible,'accepted login is not online yet');
p=decide(p,{...online,last_check:130,reason_code:'login_verified'},r,null,2);
check(p.eligible,'verified login restores');
p=decide(p,{...online,state:'action_required',reason_code:'portal_detected',last_check:140},r,null,2);
check(!p.eligible,'explicit unauthenticated removes');
check(!p.needs_refresh,'authentication failures use plugin retry schedule');
p=decide(p,{...online,last_check:139},r,null,2);
check(!p.eligible,'stale positive cannot reverse a newer unauthenticated result');
p=decide(p,{...online,state:'backoff',reason_code:'timeout',last_check:150},r,null,2);
check(!p.eligible,'unknown error cannot restore known offline');
p=decide(p,{...online,last_check:160},r,null,2);
let event={token:'event-1',time:170};
p=decide(p,{...online,last_check:160},r,event,2);
check(!p.eligible && p.floor==171,'physical event invalidates old online');
check(p.needs_refresh,'physical event requests one plugin refresh');
p=decide(p,{...online,last_check:170},r,event,2);
check(!p.eligible,'same-second pre-event result not accepted');
p=decide(p,{...online,last_check:172},r,event,2);
check(p.eligible,'post-event online restores');
check(!p.needs_refresh,'confirmed refresh does not create another probe');
let newroute={...r,ip:'172.21.106.132'};
p=decide(p,{...online,last_check:180},newroute,event,2);
check(!p.eligible,'IP change invalidates old status');
p=decide(p,{...online,ip:newroute.ip,last_check:181},newroute,event,2);
check(p.eligible,'new IP confirmed');
p=decide(p,null,{up:false},event,2);
check(!p.eligible,'physical down removes even with missing plugin');
check(!decide(null,{...online,state:'backoff',reason_code:'timeout'},r,null,1).eligible,'cold start unknown stays offline');
check(!decide(null,{...online,task_id:'task-9'},r,null,1).eligible,'in-flight old online cannot initialize eligibility');
check(!decide(null,online,{...r,default_down:true},null,1).eligible,'missing default route excludes');
let d=decide(decide(null,online,r,null,1),online,{...r,default_down:true},null,1);
check(!decide(d,online,r,null,1).eligible,'route restoration requires fresh confirmation');
print('PASS: '+count+' eligibility transition checks\n');
