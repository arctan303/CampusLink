{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CampusLink school preset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "label", "provider", "defaults", "verification_status"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "label": {"type": "string", "minLength": 1, "maxLength": 128},
    "description": {"type": "string", "maxLength": 1024},
    "provider": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "defaults": {
      "type": "object", "maxProperties": 64,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]{0,63}$"},
      "additionalProperties": {"type": ["string", "integer", "boolean"]}
    },
    "verification_status": {"enum": ["unverified", "verified"]},
    "verification": {
      "type": "object", "additionalProperties": false, "required": ["date", "environment", "summary"],
      "properties": {
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "environment": {"type": "string", "minLength": 1, "maxLength": 256},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    }
  },
  "allOf": [{"if": {"properties": {"verification_status": {"const": "verified"}}}, "then": {"required": ["verification"]}}]
}
